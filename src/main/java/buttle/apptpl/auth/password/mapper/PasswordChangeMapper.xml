<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="buttle.apptpl.auth.password.mapper.PasswordChangeMapper">

    <!-- 비밀번호 검증 -->
    <select id="validatePassword" parameterType="buttle.apptpl.auth.password.vo.COM0020001Vo" resultType="buttle.apptpl.auth.password.vo.COM0020001Vo">
        SELECT
            a.usr_id AS user_id, /* 사용자 ID */
            a.pswd,    /* 비밀번호 */
            a.lgn_try_rcn AS lgn_try_cnt /* 로그인 시도 수 */
        FROM cdm_own.usr a /* 사용자 */
        WHERE 1=1
        <if test="userId != null and userId != ''">
            AND a.usr_id = #{userId}
        </if>
    </select>
    
    <!-- 비밀번호 재사용 검증용 — 정책 주기 안의 이력 해시 목록 (최신순)

         ⚠ 종전 문장(countChangePassword)은 여기서 `AND pswd = #{pswd}` 로 해시를 동등비교했다.
         저장 형식이 BCrypt 라 같은 비밀번호도 매번 다른 해시가 되므로 그 조건은 <언제나 거짓>이었고,
         정책(cmpt_pswd_plcy.pswd_reuse_yn='N')이 켜져 있어도 아무것도 막지 못했다.
         「검사가 없다」보다 나쁜 상태다 — 있는 것처럼 보이기 때문이다.

         BCrypt 는 원문 없이 비교할 수 없으므로 이 판정을 SQL 로 되돌릴 수 없다.
         여기서는 <후보를 좁혀 주기만> 하고, 비교는 원문을 가진 PasswordChangeService 가
         matches() 로 행마다 돈다. -->
    <select id="selectRecentPasswordHashes" resultType="string">
        SELECT pswd
        FROM cdm_own.cmpt_pswd_hstry
        WHERE user_id = #{userId}
        AND pswd IS NOT NULL
        AND chg_dt <![CDATA[ > ]]> CURRENT_TIMESTAMP - (CAST(#{days} AS integer) * INTERVAL '1 day')
        ORDER BY chg_dt DESC
        LIMIT CAST(#{limit} AS integer)
    </select>

</mapper> 