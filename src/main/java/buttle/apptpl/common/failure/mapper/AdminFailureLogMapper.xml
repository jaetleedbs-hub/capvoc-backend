<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="buttle.apptpl.common.failure.mapper.AdminFailureLogMapper">

    <!--
      장애 한 건.

      ⛔ log_sid 를 «넣지 않는다» — GENERATED ALWAYS AS IDENTITY 다(2026-09-10 실측).
         값을 주면 오류가 난다. 「기본키니까 채워야 한다」로 읽기 쉬운 자리다.

      ⛔ src_schema · src_log_id 도 «넣지 않는다» — 그 둘은 <배치가 desk 표에서 끌어온 행>의
         원본 추적용이다. admin 이 «자기» 오류를 남기는 이 경로에는 원본이 없다.
         UNIQUE(svc_cd, src_schema, src_log_id) 가 부분 인덱스(WHERE src_log_id IS NOT NULL)인
         이유가 이것이다 — 여기서 넣는 행은 그 제약에 걸리지 않는다.

      rgtr_id·reg_dt·mdfr_id·mdfcn_dt 는 컬럼 기본값(system·CURRENT_TIMESTAMP)이 있어 생략한다.

      prgrm_id·http_method·url_addr·user_id·ip_addr 은 <HTTP 요청을 전제한> 옛 칸이라
      여기서 채우지 않는다. 요청 밖 실패(배치·afterCommit·설정)도 같은 표에 오므로,
      「어디서」는 subject 가 답한다.
    -->
    <insert id="insertFailure">
        INSERT INTO cdm_own.logt_error_log (
             log_dt
            ,err_cd
            ,err_cn
            ,svc_cd
            ,svr_id
            ,cmpy_id
            ,fail_kind_cd
            ,subject
            ,sev_cd
        ) VALUES (
             #{occurredAt}
            ,#{errCd}
            ,#{reason}
            ,#{svcCd}
            ,#{svrId}
            ,#{cmpyId}
            ,#{failKindCd}
            ,#{subject}
            ,#{sevCd}
        )
    </insert>

</mapper>
