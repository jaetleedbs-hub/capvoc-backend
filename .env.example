# ─────────────────────────────────────────────────────────────────────────────
#  로컬 개발용 환경변수 템플릿
#
#   사용법:  cp .env.example .env   후 값 채우기
#
#  · application*.yml 에는 ${ENV} 참조만 있다. 값은 전부 여기서 온다.
#  · .env 가 있으면 build.gradle 의 로더가 `bootRun`·`test` 에 자동 주입한다.
#  · .env 는 .gitignore 대상이다. 절대 커밋하지 않는다.
#
#  ★ 이 파일이 낡으면 `./gradlew test` 가 빌드를 실패시킨다
#    (EnvExampleCompletenessTest — yml 이 기본값 없이 읽는 키가 여기 없으면 잡는다).
#    새 환경변수를 읽기 시작했다면 여기에도 한 줄 추가한다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 서버 ─────────────────────────────────────────────────────────────────────
# 백엔드 포트. 프론트(vite)의 프록시 대상과 반드시 짝이 맞아야 한다.
SERVER_PORT=18030

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
#  스키마는 <currentSchema 하나>로 정한다. 소스 어디에도 스키마명이 박혀 있지 않으므로
#  DB_SCHEMA 만 바꾸면 통째로 옮겨 갈 수 있다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apptpl
DB_SCHEMA=apptpl
DB_USERNAME=apptpl
# 비우면 인증 실패로 기동한다(HikariCP 가 커넥션을 못 연다).
DB_PASSWORD=

# ── 시크릿 ───────────────────────────────────────────────────────────────────
#  ★ 아래 셋은 <미설정이면 기동 시 검증에 걸린다>(SecretsStartupValidator).
#    운영 프로파일에서는 기동이 거부되고, 로컬에서는 ERROR 로그만 남고 뜬다.
#
#  값 만들기 —
#    APPTPL_AES_KEY   : 32바이트. `openssl rand -base64 32`
#    APPTPL_JWT_SECRET: HS512 라 <충분히 긴> BASE64. `openssl rand -base64 64`
#    JASYPT_...       : 아무 긴 문자열. 단, yml 의 ENC(...) 값을 만든 키와 같아야 복호된다

# 개인정보 컬럼 암·복호(AES-256-GCM). 바뀌면 <기존 데이터를 못 읽는다>
APPTPL_AES_KEY=
# 로그인 토큰 서명. 바뀌면 발급된 토큰이 전부 무효가 된다(재로그인 필요)
APPTPL_JWT_SECRET=
# yml 안의 ENC(...) 값을 푸는 마스터키. 미설정이면 개인정보 읽기/쓰기에서 실패한다
JASYPT_ENCRYPTOR_PASSWORD=

# ── 메일 발송 ────────────────────────────────────────────────────────────────
#  비워 두면 메일 발송만 동작하지 않는다(앱은 정상 기동).
#  로컬에서 /actuator/health 가 DOWN 인 것은 대개 이것 때문이며, 기동 실패가 아니다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 발신 주소(From). 비우면 발송 단계에서 실패한다
MAIL_FROM=

# ★★ 개발용 안전망 — 반드시 자기 주소를 넣는다 ★★
#  값이 있으면 <원래 수신자를 전부 버리고> 이 주소로만 보낸다.
#  비워 두면 발송 화면 시험이 DB 의 실제 사용자에게 그대로 나간다.
#  ⛔ 운영에는 설정하지 않는다 — 운영 프로파일에서는 이 값이 있으면 기동을 거부한다.
MAIL_OVERRIDE_TO=

# ── SMS 발송 ─────────────────────────────────────────────────────────────────
#  사전등록된 발신번호여야 한다. 비우면 SMS 발송이 거절된다.
#  ⛔ 발송 API 를 <상태 확인용>으로 부르지 않는다 — GET 이어도 실제로 나간다.
SMS_DEFAULT_SNDR_TELNO=
SMS_DEFAULT_SNDR_NM=

# ── 서비스 간(S2S) 인증 ──────────────────────────────────────────────────────
#  들어오는 호출이 X-Api-Key 로 보내야 하는 값. 부르는 쪽과 같아야 한다.
#  ★ 기본값을 두지 않는다 — 설정 누락이 곧 무인증 개방이 되지 않게 하기 위한 것이다.
INTERNAL_API_KEY=local-api-key
# AUDIT(경고만) / ENFORCE(401 차단). 로컬은 AUDIT, 운영은 ENFORCE.
INTERNAL_API_AUTH_POLICY=AUDIT
# 나가는 호출에 실을 키
OUTBOUND_API_KEY=local-api-key

# ── 인가 정책 ────────────────────────────────────────────────────────────────
#  OFF / AUDIT / ENFORCE — 프로그램-권한 매핑에 없는 API 를 어떻게 다룰지.
#  새 화면을 만드는 동안에는 AUDIT 로 둔다(ENFORCE 면 매핑 등록 전까지 403).
API_AUTH_POLICY=AUDIT

# ── 그 밖 ────────────────────────────────────────────────────────────────────
# 파일 ID·업로드 폴더의 접두어. 프로젝트마다 바꾼다
SYSTEM_CODE=apptpl
# 기본 조직(회원사) ID. db/sql 시드의 cmpt_cmpy_inf 행과 같아야 한다
SYSTEM_COMPANY_ID=00000
# 장애기록(logt_error_log.svc_cd)에 남을 이 앱의 코드값. ASCII
SERVICE_CODE=APPTPL
# 업로드 저장 위치
FILE_UPLOAD_PATH=./data/upload
# CORS 허용 origin. 쉼표 구분. 로컬은 '*' 로 두어도 되지만 운영은 실제 origin 으로 덮는다
SVC_ENV_CORS_ORIGINS=*
